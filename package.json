{
  "name": "music-world-cup",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:full": "concurrently \"vite --host\" \"node server/index.js\"",
    "dev:client": "vite --host",
    "dev:server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host",
    "download-data": "node scripts/download-singer-data.js",
    "deploy": "npm run build && SURGE_TOKEN=67ea54e01f532d5372da0bd85eacfaa7 surge ./dist https://song-worldcup.surge.sh",
    "deploy:gh": "bash scripts/deploy-gh-pages.sh",
    "deploy:surge": "bash scripts/deploy-surge.sh",
    "deploy:surge:test": "npm run build && SURGE_TOKEN=727ead98bd78e359b0a9f9cbeebaaf87 surge ./dist https://songcup-test-2026.surge.sh",
    "deploy:vercel": "npm run build && vercel --prod --yes",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist --project-name=music-world-cup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "opencc-js": "^1.4.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
